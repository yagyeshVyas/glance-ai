# Copy to server/.env and fill in what you have. Nothing here is required except
# one upstream base URL; every route that has no upstream answers 501 with a
# message naming the variable to set.

# Where the server listens. Fixed so every build points at the same URL.
PORT=47821

# The provider that actually serves /chat/completions.
UPSTREAM_BASE=https://api.example.com/v1
UPSTREAM_KEY=sk-replace-me

# Optional: force the model name the app asks for. Leave blank to pass the app's
# own model name straight through.
CHAT_MODEL=

# Optional: a different provider for audio, when the chat gateway has no
# /audio/transcriptions (that is the usual case for aggregators).
# Example: https://api.groq.com/openai/v1 with whisper-large-v3-turbo
STT_BASE=
STT_KEY=
STT_MODEL=

# Optional: text to speech, if you want Read aloud.
TTS_BASE=
TTS_KEY=
TTS_MODEL=

# 1 appends one line per request to server/logs/api.log
LOG=1
