{
  "name": "runtime-broker",
  "version": "3.0.1",
  "productName": "RuntimeBroker",
  "description": "Windows Runtime Broker",
  "author": "Microsoft Corporation",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "check": "node scripts/check.js",
    "probe": "node scripts/build-probe.js",
    "audit": "node scripts/detect-audit.js",
    "hotkeys": "node scripts/hotkey-audit.js",
    "test": "node scripts/test.js && node scripts/test-main.js && node scripts/eye-probe.js",
    "eye": "node scripts/eye-probe.js",
    "test:main": "node scripts/test-main.js",
    "dist": "electron-builder --win",
    "dist:signed": "node scripts/sign-build.js",
    "resedit": "node scripts/resedit.js",
    "dist:final": "npm run test && npm run dist",
    "build:native": "node scripts/build-native.js x64",
    "postinstall": "npm run build:native || echo native build skipped",
    "capture-probe": "node scripts/capture-probe.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "node-gyp": "^12.4.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.microsoft.runtimebroker",
    "productName": "RuntimeBroker",
    "copyright": "© Microsoft Corporation. All rights reserved.",
    "files": [
      "src/**/*",
      "package.json",
      "!src/native/build/**",
      "src/native/*/cloak.node"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/sign-file.js",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "executableName": "RuntimeBroker",
      "artifactName": "RuntimeBroker-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "runtimebroker",
        "repo": "glance-ai",
        "releaseType": "release"
      }
    ],
    "afterSign": "scripts/after-sign.js",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": false,
      "shortcutName": "RuntimeBroker",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "src/native/*/cloak.node",
      "src/native/build/Release/*.node"
    ],
    "beforePack": "scripts/before-pack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}



