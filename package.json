{
  "name": "glance-ai",
  "version": "3.4.0",
  "productName": "Glance AI",
  "description": "Glance AI desktop assistant",
  "author": "Glance AI",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "check": "node scripts/check.js",
    "probe": "node scripts/build-probe.js",
    "audit": "node scripts/detect-audit.js",
    "hotkeys": "node scripts/hotkey-audit.js",
    "test": "node scripts/test.js && node scripts/test-main.js && node scripts/test-embeddings.js && node scripts/eye-probe.js && node scripts/ocr-probe.js",
    "eye": "node scripts/eye-probe.js",
    "test:main": "node scripts/test-main.js",
    "dist": "electron-builder --win --publish never",
    "dist:signed": "node scripts/sign-build.js",
    "verify:build": "node scripts/verify-build.js",
    "resedit": "node scripts/resedit.js",
    "dist:final": "npm run test && npm run dist",
    "ocr-helper": "node scripts/build-ocr-helper.js",
    "capture-probe": "node scripts/capture-probe.js",
    "probe:composite": "node scripts/composite-probe.js",
    "probe:api": "node scripts/api-probe.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "ai.glance.desktop",
    "productName": "Glance AI",
    "copyright": "© Glance AI. All rights reserved.",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/sign-file.js",
        "publisherName": "CN=Glance AI, O=Glance AI, C=US",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "executableName": "GlanceAI",
      "artifactName": "GlanceAI-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yagyeshVyas",
        "repo": "glance-ai",
        "releaseType": "release"
      }
    ],
    "afterSign": "scripts/after-sign.js",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "menuCategory": false,
      "shortcutName": "Glance AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "build/ocr-helper.exe",
        "to": "ocr-helper.exe"
      }
    ],
    "beforePack": "scripts/before-pack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
